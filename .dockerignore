# Keep the build context minimal and free of repo metadata that a build
# step shouldn't need. .git in particular can leak credentials/config if
# a hostile Dockerfile inspects the build context.
.git
.github
.venv
.pytest_cache
.ruff_cache
__pycache__
*.pyc
tests
docs
docker-compose*.yml
# README.md is intentionally NOT excluded — Dockerfile copies it for
# the long_description metadata when pip-installing the package.
